    <string name="debug_tool_email_subject">நாள்காட்டி Db இணைக்கப்பட்டது</string>
    <string name="debug_tool_email_body">என்னுடைய எல்லா அப்பாய்ண்ட்மென்ட்கள் மற்றும் தனிப்பட்ட தகவல்களுடன் உள்ள கேலெண்டர் தரவுதளம் இணைக்கப்பட்டுள்ளது. கவனமாகக் கையாளவும்.</string>
